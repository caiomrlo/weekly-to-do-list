# ==============================================================================
# Environment Variables Configuration
# ==============================================================================

# PostgreSQL Credentials (container db)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_DB=weekly_todo_db

# Connection String para scripts no Host (localhost)
DATABASE_URL="postgresql://appuser:apppass@localhost:5432/weekly_todo_db"

PORT=3000
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
# Fallback for legacy secret
AUTH_SECRET="your-super-secret-key-at-least-32-chars"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID="7dee7eb4301d6e32b73e2c669fd20d1e"
R2_ACCESS_KEY_ID="54f64d185e894e32ea28d9c40a1e6164"
R2_SECRET_ACCESS_KEY="7897b69ca544941de41a395a43785b340dc9276deceb4a2a96075174f50689b8"
R2_BUCKET_NAME="weekly-local"
# Optional: Public CDN/bucket URL for direct unauthenticated access to public assets like avatars
# R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ==============================================================================
# AI Agent Configuration
# ==============================================================================
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-6-luna"
# Optional: custom base URL for OpenAI-compatible proxies (e.g. OpenRouter, Groq, Ollama)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ==============================================================================
# Web Push & Scheduled Notifications
# ==============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:notifications@weeklytodo.com"
CRON_SECRET="your-secure-cron-secret-token"

