# syntax=docker/dockerfile:1
# Next.js Development Dockerfile (Fast Refresh & Live Reload)

FROM node:22-alpine

WORKDIR /app

# Install compatibility libraries for native packages (e.g. sharp, turbopack)
RUN apk add --no-cache libc6-compat

# Install dependencies including devDependencies with persistent BuildKit cache mount
COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm install

# Copy application source code (fallback; overridden by compose watch / volume sync)
COPY . .

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=development

EXPOSE 3000

CMD ["npm", "run", "dev"]
